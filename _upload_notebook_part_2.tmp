    "    idx_ext_val_320\n",
    ")\n",
    "\n",
    "assert predicciones_C_320[\n",
    "    \"prob_adverso\"\n",
    "].between(0, 1).all()\n",
    "\n",
    "assert (\n",
    "    metricas_C_320[\"VN\"]\n",
    "    + metricas_C_320[\"FP\"]\n",
    "    + metricas_C_320[\"FN\"]\n",
    "    + metricas_C_320[\"VP\"]\n",
    ") == len(idx_ext_val_320)\n",
    "\n",
    "assert set(\n",
    "    grupos_320.iloc[idx_ext_train_320]\n",
    ").isdisjoint(\n",
