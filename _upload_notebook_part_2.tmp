    "\n",
    "print(\n",
    "    \"Tiempo total:\",\n",
    "    round(\n",
    "        time.perf_counter() - inicio_total_320,\n",
    "        1\n",
    "    ),\n",
    "    \"segundos\"\n",
    ")\n",
