   "cell_type": "code",
   "execution_count": null,
   "id": "oulad-172",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 784
    },
    "id": "oulad-172",
    "outputId": "0ae360de-6074-4431-eb72-5b292e263a20"
   },
   "outputs": [
    {
     "data": {
      "image/png": "\n"
     },
     "metadata": {},
     "output_type": "display_data"
