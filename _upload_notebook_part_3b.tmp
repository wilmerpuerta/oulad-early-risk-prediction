    ")\n",
    "\n",
    "assert np.isclose(\n",
    "    auditoria_342[\"Puntaje_maximo\"].sum(),\n",
    "    10.0\n",
    ")\n",
    "\n",
    "assert hashlib.sha256(\n",
    "    rutas_342[\"protocolo\"].read_bytes()\n",
    ").hexdigest() == sha_esperado_342\n",
    "\n",
    "print(\"Rúbrica: 11 criterios auditados\")\n",
    "print(\"Métricas adicionales: 8 configuraciones\")\n",
