    "\n",
    "    principal_337 = tabla_candidatos_337.loc[\n",
    "        \"LR B | Grid\"\n",
    "    ]\n",
    "\n",
    "    print(\"Modelo principal: LogisticRegression B\")\n",
    "    print(\"Optimización: GridSearchCV\")\n",
    "    print(\"Ventanas:\", SEMANAS_337)\n",
    "\n",
    "    print(\n",
    "        \"F1 macro en desarrollo (semana 8):\",\n",
